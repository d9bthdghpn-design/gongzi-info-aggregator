# ============================================
# 对公资讯聚合系统 - 环境变量配置
# ============================================
# 复制此文件为 .env 并根据实际情况修改

# ---------- 数据库配置 ----------
POSTGRES_DB=gongzi_info
POSTGRES_USER=gongzi
POSTGRES_PASSWORD=gongzi123
POSTGRES_PORT=5432

# ---------- Redis配置 ----------
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# ---------- 服务端口 ----------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ---------- JWT配置 ----------
JWT_SECRET_KEY=please-change-this-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AI配置 ----------
# 留空则使用模拟模式（不调用真实API，用于开发测试）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-3.5-turbo

# ---------- 采集配置 ----------
# 代理池配置（可选）
PROXY_POOL_ENABLED=false
PROXY_POOL_REDIS_KEY=proxy_pool

# ---------- SSO配置（可选） ----------
SSO_ENABLED=false
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=

# ---------- 监控配置（可选） ----------
PROMETHEUS_ENABLED=false
