# ============================================
# 对公资讯聚合系统 - .gitignore
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# 虚拟环境
venv/
.venv/
env/
.env/
ENV/

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 前端构建产物
frontend/dist/

# ---------- 环境变量 ----------
.env
.env.local
.env.*.local
*.env

# 保留示例文件
!.env.example
!.env.render.example

# ---------- 数据库 ----------
*.db
*.sqlite
*.sqlite3
*.sql.bak

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 日志 ----------
logs/
*.log

# ---------- Docker ----------
.docker/

# ---------- 采集器 ----------
crawler/output/
crawler/data/
*.csv
*.json.bak

# ---------- 临时文件 ----------
*.tmp
*.bak
*.cache

# ---------- 本地测试 ----------
.workbuddy/
test_crawl.py
verify_crawl.py
test_write.py

# ---------- 本地运维脚本（含敏感信息，不提交）----------
test_*.py
find_*.py
run_crawl*.py
run_ai_process.py
add_new_sources.py
enable_*.py
check_*.py
list_sources.py
migrate_supabase.py
