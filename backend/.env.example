# ============================================================
# 对公资讯聚合系统 - 环境变量配置示例
# 复制为 .env 文件后修改
# ============================================================

# 应用配置
DEBUG=false
APP_NAME=对公资讯聚合系统
APP_VERSION=1.0.0

# 数据库配置
DATABASE_URL=postgresql+psycopg2://gongzi:gongzi123@postgres:5432/gongzi_info
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis配置
REDIS_URL=redis://redis:6379/0

# JWT配置（生产环境务必修改）
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI大模型配置
AI_MODEL=gpt-3.5-turbo
AI_API_KEY=your-api-key-here
AI_BASE_URL=
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# 采集配置
CRAWL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
CRAWL_DELAY=1.0
PROXY_POOL_ENABLED=false

# SSO配置（企业微信）
SSO_WECOM_ENABLED=false
SSO_WECOM_CORP_ID=
SSO_WECOM_AGENT_ID=
SSO_WECOM_SECRET=

# SSO配置（飞书）
SSO_FEISHU_ENABLED=false
SSO_FEISHU_APP_ID=
SSO_FEISHU_APP_SECRET=

# 安全配置
IP_WHITELIST_ENABLED=false
CORS_ORIGINS=*

# 分页配置
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
